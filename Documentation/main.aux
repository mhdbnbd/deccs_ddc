\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.1}AwA2: K-means vs.\ DECCS Consensus}{23}{subsection.4.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces t-SNE projections of AwA2 ResNet features colored by cluster assignment. Left: K-means (NMI = 0.869). Right: DECCS consensus (NMI = 0.871). Both produce well-separated clusters, reflecting the strong discriminative power of ResNet features on animal images. (The projection shows a single representative seed; the tables report 10-run means.) Source: \texttt  {results/awa2/kmeans/tsne.png} and \texttt  {results/awa2/deccs/tsne.png}.}}{23}{figure.caption.20}\protected@file@percent }
\newlabel{fig:tsne_awa2}{{4.1}{23}{t-SNE projections of AwA2 ResNet features colored by cluster assignment. Left: K-means (NMI = 0.869). Right: DECCS consensus (NMI = 0.871). Both produce well-separated clusters, reflecting the strong discriminative power of ResNet features on animal images. (The projection shows a single representative seed; the tables report 10-run means.) Source: \texttt {results/awa2/kmeans/tsne.png} and \texttt {results/awa2/deccs/tsne.png}}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.2}aPY Full (K = 32): K-means vs.\ DECCS Consensus}{23}{subsection.4.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces t-SNE projections of aPY full dataset (32 classes). Left: K-means (NMI = 0.534). Right: DECCS consensus (NMI = 0.611). The values in the panel titles are for the plotted seed; the 10-run means are 0.534 and 0.618 (Table~\ref {tab:apy32_results}). The consensus ensemble produces clusters that align more closely with the true object classes, particularly in separating vehicles from furniture and small objects---the largest gain from consensus in our experiments. As discussed in Section~\ref {sec:interpretation}, this class-level improvement coexists with a lower Silhouette score, which measures Euclidean compactness rather than class agreement. (The projection shows a single representative seed; the tables report 10-run means.) Source: \texttt  {results/apy/kmeans/tsne.png} and \texttt  {results/apy/deccs/tsne.png}.}}{24}{figure.caption.21}\protected@file@percent }
\newlabel{fig:tsne_apy32}{{4.2}{24}{t-SNE projections of aPY full dataset (32 classes). Left: K-means (NMI = 0.534). Right: DECCS consensus (NMI = 0.611). The values in the panel titles are for the plotted seed; the 10-run means are 0.534 and 0.618 (Table~\ref {tab:apy32_results}). The consensus ensemble produces clusters that align more closely with the true object classes, particularly in separating vehicles from furniture and small objects---the largest gain from consensus in our experiments. As discussed in Section~\ref {sec:interpretation}, this class-level improvement coexists with a lower Silhouette score, which measures Euclidean compactness rather than class agreement. (The projection shows a single representative seed; the tables report 10-run means.) Source: \texttt {results/apy/kmeans/tsne.png} and \texttt {results/apy/deccs/tsne.png}}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.3}aPY 15-Class Subset (K = 15): K-means vs.\ DECCS Consensus}{24}{subsection.4.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces t-SNE projections of aPY 15-class subset. Left: K-means (NMI = 0.665). Right: DECCS consensus (NMI = 0.677). The values in the panel titles are for the plotted seed; the 10-run means are 0.666 and 0.684 (Table~\ref {tab:apy15_results}). Distinct groups are visible for animals (top), vehicles (left), and furniture/objects (bottom). (The projection shows a single representative seed; the tables report 10-run means.) Source: \texttt  {results/apy\_15/kmeans/tsne.png} and \texttt  {results/apy\_15/deccs/tsne.png}.}}{24}{figure.caption.22}\protected@file@percent }
\newlabel{fig:tsne_apy15}{{4.3}{24}{t-SNE projections of aPY 15-class subset. Left: K-means (NMI = 0.665). Right: DECCS consensus (NMI = 0.677). The values in the panel titles are for the plotted seed; the 10-run means are 0.666 and 0.684 (Table~\ref {tab:apy15_results}). Distinct groups are visible for animals (top), vehicles (left), and furniture/objects (bottom). (The projection shows a single representative seed; the tables report 10-run means.) Source: \texttt {results/apy\_15/kmeans/tsne.png} and \texttt {results/apy\_15/deccs/tsne.png}}{figure.caption.22}{}}
